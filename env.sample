# =============================================================================
#  GitLab Migration Tool — Sample .env
#  Copy this file to .env and fill in the real values before running.
# =============================================================================


# ---------------------------------------------------------------------------
# GitLab Connection (REQUIRED)
# ---------------------------------------------------------------------------

GITLAB_BASE_URL   = https://gitlab.yourcompany.com
GITLAB_TOKEN      = glpat-xxxxxxxxxxxxxxxxxxxx

# Set to false ONLY if you're on a self-hosted GitLab with a self-signed cert
GITLAB_VERIFY_SSL = true


# ---------------------------------------------------------------------------
# Project List  (REQUIRED)
#   Format:  PROJECTS = <id>:<name>, <id>:<name>, ...
#   Each ID must be the GitLab numeric project ID.
#   Replace the 14 entries below with your real project IDs and names.
# ---------------------------------------------------------------------------

PROJECTS = \
  101:service-auth, \
  102:service-billing, \
  103:service-catalog, \
  104:service-checkout, \
  105:service-config, \
  106:service-delivery, \
  107:service-events, \
  108:service-gateway, \
  109:service-inventory, \
  110:service-notifications, \
  111:service-orders, \
  112:service-payments, \
  113:service-reporting, \
  114:service-users


# ---------------------------------------------------------------------------
# Migration Branch Settings
# ---------------------------------------------------------------------------

# Jira ticket number (used as part of the feature branch name)
JIRA_ID          = 12938

# Feature branch will be named: <BRANCH_PREFIX><JIRA_ID>-<BRANCH_SUFFIX>
# Example: task-12938-java17-migration
BRANCH_PREFIX    = task-
BRANCH_SUFFIX    = java17-migration


# ---------------------------------------------------------------------------
# Java / Platform Upgrade Settings  (REQUIRED for pom.xml rewrite)
# ---------------------------------------------------------------------------

# The full platform string for the new Elastic Beanstalk Java 17 environment
# This replaces the platform line in .elasticbeanstalk/config.yml
NEW_DEFAULT_PLATFORM = 64bit Amazon Linux 2023 v4.1.0 running Corretto 17


# ---------------------------------------------------------------------------
# Parent POM Version  (optional — used for version bump)
# ---------------------------------------------------------------------------

# If you have a shared parent pom, put its GitLab project ID here.
# The tool will read the current version automatically.
PARENT_POM_PROJECT_ID = 99


# ---------------------------------------------------------------------------
# Merge Request Settings
# ---------------------------------------------------------------------------

# Comma-separated GitLab usernames for reviewers / assignees on generated MRs
REVIEWER_USERNAMES  = jane.smith, bob.jones
ASSIGNEE_USERNAMES  = alice.dev


# ---------------------------------------------------------------------------
# Presto / JKS Certificate Projects  (optional)
#   List the project IDs that use Presto and require a JKS cert replacement.
#   You can also use the 🔍 Auto-Detect button in the UI to find these
#   automatically — it scans for src/main/resources/presto.jks in each repo.
# ---------------------------------------------------------------------------

PRESTO_PROJECT_IDS = 103, 107, 112


# ---------------------------------------------------------------------------
# Actuator Health-Check URLs  (optional — enables health badges in UI)
#   Format:  <project_id>:<url>
# ---------------------------------------------------------------------------

ACTUATOR_101_DEV  = https://service-auth-dev.yourcompany.com/actuator/health
ACTUATOR_102_DEV  = https://service-billing-dev.yourcompany.com/actuator/health

ACTUATOR_101_TEST = https://service-auth-test.yourcompany.com/actuator/health
ACTUATOR_102_TEST = https://service-billing-test.yourcompany.com/actuator/health

# Performance environment health check — optional.
# Add ACTUATOR_<project_id>_PERF for any project that has a PERF environment.
# If omitted for a project, no PERF badge will appear for that project in the Full Migration tab.
ACTUATOR_101_PERF = https://service-auth-perf.yourcompany.com/actuator/health


# ---------------------------------------------------------------------------
# Performance Probe URLs  (optional — enables perf badges in UI)
# ---------------------------------------------------------------------------

PERF_URLS_DEV  = 101:https://service-auth-dev.yourcompany.com/actuator/metrics
PERF_URLS_TEST = 101:https://service-auth-test.yourcompany.com/actuator/metrics


# ---------------------------------------------------------------------------
# Concurrency Controls
# ---------------------------------------------------------------------------

# Maximum number of full migrations running at the same time.
# 3 is the sweet spot for most GitLab setups (circuit breaker kicks in after
# 2 consecutive failures and pauses the queue automatically).
MAX_CONCURRENT_MIGRATIONS = 3
